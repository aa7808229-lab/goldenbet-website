* {
  box-sizing: border-box;
}

:root {
  --bg: #07111d;
  --bg-strong: #020a13;
  --panel: #101d2a;
  --panel-soft: #0d1725;
  --line: rgba(255, 255, 255, 0.08);
  --text: #edf3ff;
  --muted: #a3b4c8;
  --gold: #d7a84d;
  --gold-soft: #f5d98a;
  --navy: #12273a;
  --success: #1fbf75;
  --shadow: 0 18px 40px rgba(2, 6, 12, 0.45);
}

html,
body,
#root {
  margin: 0;
  min-height: 100%;
  width: 100%;
  background: radial-gradient(circle at top, #0d1a2b 0%, var(--bg) 42%, var(--bg-strong) 100%);
  color: var(--text);
  font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
}

body {
  overflow-x: hidden;
}

a {
  color: inherit;
  text-decoration: none;
}

button,
input,
select {
  font: inherit;
}

button {
  cursor: pointer;
}

.app-shell {
  min-height: 100vh;
  width: 100%;
}

.topbar {
  position: sticky;
  top: 0;
  z-index: 50;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  padding: 1rem 1.5rem;
  background: rgba(7, 17, 29, 0.9);
  border-bottom: 1px solid var(--line);
  backdrop-filter: blur(14px);
}

.brand-block {
  display: flex;
  align-items: center;
}

.brand {
  display: inline-flex;
  align-items: center;
  gap: 0.75rem;
  font-size: 1.3rem;
  font-weight: 800;
  letter-spacing: 0.04em;
}

.brand-mark {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 2.2rem;
  height: 2.2rem;
  border-radius: 0.8rem;
  background: linear-gradient(135deg, var(--gold-soft), var(--gold));
  color: #0b1220;
  font-weight: 900;
}

.toolbar {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  flex-wrap: wrap;
}

.selector {
  display: flex;
  flex-direction: column;
  gap: 0.35rem;
  min-width: 110px;
  color: var(--muted);
  font-size: 0.72rem;
}

.selector select,
.search-form input,
.search-panel input,
.auth-form input,
.auth-form select,
.summary-row input,
.compact-form input,
.compact-form select {
  width: 100%;
  border: 1px solid var(--line);
  border-radius: 0.8rem;
  background: rgba(10, 22, 31, 0.9);
  color: var(--text);
  padding: 0.75rem 0.85rem;
}

.primary-nav {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  flex: 1;
  flex-wrap: wrap;
}

.nav-link,
.mini-link,
.auth-link {
  border: 1px solid transparent;
  border-radius: 999px;
  padding: 0.6rem 0.95rem;
  font-weight: 600;
  color: var(--muted);
  transition: all 0.2s ease;
}

.nav-link:hover,
.mini-link:hover,
.auth-link:hover,
.nav-link.active {
  border-color: rgba(215, 168, 77, 0.5);
  background: rgba(215, 168, 77, 0.09);
  color: var(--text);
}

.header-actions {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  flex-wrap: wrap;
  justify-content: flex-end;
}

.search-form {
  display: flex;
  align-items: center;
  gap: 0.6rem;
  min-width: min(100%, 300px);
}

.search-form input {
  min-width: 180px;
}

.search-form button,
.primary-button,
.secondary-button {
  border: none;
  border-radius: 0.8rem;
  transition: transform 0.2s ease, opacity 0.2s ease;
}

.primary-button,
.secondary-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0.8rem 1.2rem;
  font-weight: 700;
}

.primary-button {
  background: linear-gradient(135deg, var(--gold-soft), var(--gold));
  color: #0d121a;
}

.primary-button:hover,
.secondary-button:hover,
.odd-button:hover,
.text-button:hover {
  transform: translateY(-1px);
}

.secondary-button {
  background: rgba(255, 255, 255, 0.03);
  border: 1px solid var(--line);
  color: var(--text);
}

.search-form button {
  background: linear-gradient(135deg, var(--gold-soft), var(--gold));
  color: #09131d;
  padding: 0.8rem 1rem;
  font-weight: 700;
}

.header-buttons {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  flex-wrap: wrap;
}

.badge-link {
  position: relative;
}

.badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 1.2rem;
  height: 1.2rem;
  padding: 0.1rem 0.35rem;
  border-radius: 999px;
  background: var(--gold);
  color: #101820;
  font-size: 0.65rem;
  font-weight: 800;
  margin-inline-start: 0.35rem;
}

.auth-link {
  background: rgba(215, 168, 77, 0.12);
  border-color: rgba(215, 168, 77, 0.3);
  color: var(--gold-soft);
}

.menu-toggle {
  display: none;
  background: transparent;
  color: var(--text);
  border: 1px solid var(--line);
  border-radius: 0.75rem;
  padding: 0.5rem 0.7rem;
}

.page-shell {
  max-width: 1400px;
  margin: 0 auto;
  padding: 1.5rem;
}

.page-content {
  padding: 0.5rem 0 2rem;
}

.hero-panel {
  display: grid;
  grid-template-columns: 1.4fr 0.7fr;
  gap: 1.25rem;
  align-items: stretch;
  padding: 1.5rem;
  border: 1px solid var(--line);
  background: linear-gradient(135deg, rgba(18, 39, 58, 0.8), rgba(7, 17, 29, 0.9));
  border-radius: 1.5rem;
  box-shadow: var(--shadow);
}

.hero-copy {
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 1rem;
}

.eyebrow {
  text-transform: uppercase;
  letter-spacing: 0.16em;
  font-size: 0.72rem;
  color: var(--gold-soft);
  margin: 0;
}

.hero-copy h1 {
  margin: 0;
  font-size: clamp(2.2rem, 5vw, 4rem);
  line-height: 1.04;
}

.hero-copy p {
  margin: 0;
  max-width: 42rem;
  color: var(--muted);
  line-height: 1.7;
}

.hero-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 0.8rem;
  margin-top: 0.75rem;
}

.large {
  padding: 0.95rem 1.4rem;
}

.hero-panel-card {
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 1rem;
  padding: 1.2rem;
  border-radius: 1.2rem;
  background: rgba(8, 18, 26, 0.9);
  border: 1px solid var(--line);
}

.top-card-row,
.mini-stats {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
}

.chip {
  background: rgba(31, 191, 117, 0.12);
  color: var(--success);
  border: 1px solid rgba(31, 191, 117, 0.25);
  border-radius: 999px;
  padding: 0.35rem 0.65rem;
  font-size: 0.7rem;
  font-weight: 700;
}

.wallet-number {
  font-size: clamp(2rem, 3vw, 3rem);
  font-weight: 800;
  letter-spacing: -0.06em;
}

.mini-stats {
  padding-top: 0.75rem;
  border-top: 1px solid var(--line);
}

.mini-stats div {
  display: flex;
  flex-direction: column;
  gap: 0.2rem;
  color: var(--muted);
}

.mini-stats strong {
  color: var(--text);
  font-size: 1.1rem;
}

.stats-grid,
.match-grid,
.league-grid,
.financial-grid,
.profile-grid {
  display: grid;
  gap: 1rem;
}

.stats-grid {
  grid-template-columns: repeat(4, minmax(0, 1fr));
  margin-top: 1.25rem;
}

.stat-box,
.money-card,
.profile-card,
.auth-card,
.slip-card,
.slip-summary-card,
.detail-panel,
.setting-item,
.league-card,
.match-card {
  border: 1px solid var(--line);
  background: rgba(12, 20, 30, 0.96);
  border-radius: 1.15rem;
  box-shadow: var(--shadow);
}

.stat-box {
  padding: 1.1rem 1rem;
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
  color: var(--muted);
}

.stat-box strong {
  color: var(--text);
  font-size: 1.7rem;
}

.content-block {
  margin-top: 2rem;
}

.section-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  margin-bottom: 1rem;
}

.section-heading h2 {
  margin: 0;
  font-size: clamp(1.5rem, 2vw, 2.3rem);
}

.section-heading a {
  color: var(--gold-soft);
  font-weight: 700;
}

.match-grid {
  grid-template-columns: repeat(3, minmax(0, 1fr));
}

.wide-grid {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.match-card {
  padding: 1rem;
  display: flex;
  flex-direction: column;
  gap: 0.9rem;
}

.match-topline,
.match-meta,
.match-actions,
.detail-header,
.detail-summary,
.summary-row,
.setting-item,
.bet-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.75rem;
}

.league-name,
.stage-label,
.match-meta {
  margin: 0;
  color: var(--muted);
}

.status-pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 999px;
  padding: 0.35rem 0.7rem;
  background: rgba(255, 255, 255, 0.04);
  border: 1px solid var(--line);
  font-size: 0.74rem;
  color: var(--gold-soft);
}

.status-pill.live {
  background: rgba(31, 191, 117, 0.12);
  border-color: rgba(31, 191, 117, 0.26);
  color: var(--success);
}

.teams-row {
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  align-items: center;
  gap: 0.75rem;
}

.team-box {
  display: flex;
  align-items: center;
  gap: 0.65rem;
  font-weight: 700;
}

.badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 2.2rem;
  height: 2.2rem;
  border-radius: 0.8rem;
  font-size: 0.7rem;
  font-weight: 800;
}

.badge.gold {
  background: rgba(215, 168, 77, 0.12);
  color: var(--gold-soft);
}

.badge.navy {
  background: rgba(255, 255, 255, 0.08);
  color: var(--text);
}

.team-box.away {
  justify-content: flex-end;
}

.score {
  font-size: 1.35rem;
  font-weight: 800;
}

.odd-grid,
.detail-odds {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 0.7rem;
}

.odd-button {
  display: flex;
  flex-direction: column;
  gap: 0.4rem;
  align-items: center;
  justify-content: center;
  padding: 0.7rem 0.65rem;
  border: 1px solid var(--line);
  background: rgba(255, 255, 255, 0.015);
  color: var(--text);
  border-radius: 0.9rem;
}

.odd-button span {
  font-size: 0.7rem;
  color: var(--muted);
}

.odd-button strong {
  font-size: 1.15rem;
}

.large-odd {
  padding: 1rem 0.75rem;
}

.match-actions {
  border-top: 1px solid var(--line);
  padding-top: 0.9rem;
}

.ghost-link {
  color: var(--gold-soft);
  font-weight: 700;
}

.league-grid {
  grid-template-columns: repeat(4, minmax(0, 1fr));
}

.league-card {
  padding: 1.2rem;
  display: flex;
  flex-direction: column;
  gap: 0.7rem;
}

.league-badge {
  display: inline-flex;
  width: fit-content;
  padding: 0.3rem 0.6rem;
  border-radius: 999px;
  background: rgba(215, 168, 77, 0.08);
  border: 1px solid rgba(215, 168, 77, 0.3);
  color: var(--gold-soft);
  font-size: 0.72rem;
}

.league-card h3 {
  margin: 0;
  font-size: 1.3rem;
}

.league-card p,
.league-meta {
  margin: 0;
  color: var(--muted);
}

.detail-panel {
  padding: 1.35rem;
  display: flex;
  flex-direction: column;
  gap: 1.2rem;
}

.detail-header h2 {
  margin: 0.2rem 0 0;
  font-size: clamp(1.8rem, 3vw, 2.6rem);
}

.score-panel {
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  gap: 1rem;
  align-items: center;
  background: rgba(255, 255, 255, 0.02);
  border: 1px solid var(--line);
  border-radius: 1rem;
  padding: 1.2rem;
}

.score-team {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  font-weight: 700;
  font-size: 1.2rem;
}

.away-score {
  justify-content: flex-end;
}

.score-separator {
  font-size: 2rem;
  color: var(--gold-soft);
  font-weight: 800;
}

.detail-summary {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 1rem;
  border: 1px solid var(--line);
  border-radius: 1rem;
  padding: 1rem;
}

.detail-summary div {
  display: flex;
  flex-direction: column;
  gap: 0.35rem;
  color: var(--muted);
}

.detail-summary strong {
  color: var(--text);
}

.statistics-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 0.9rem;
}

.stat-tile {
  border: 1px solid var(--line);
  border-radius: 0.9rem;
  padding: 1rem;
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
  background: rgba(255, 255, 255, 0.02);
}

.stat-tile span {
  color: var(--muted);
}

.stat-tile strong {
  font-size: 1.4rem;
}

.odds-section {
  display: flex;
  flex-direction: column;
  gap: 0.85rem;
}

.odds-section h3 {
  margin: 0;
}

.search-panel {
  margin: 1rem 0 1.5rem;
}

.search-panel input {
  max-width: 520px;
}

.empty-state {
  grid-column: 1 / -1;
  text-align: center;
  padding: 3rem 1rem;
  border: 1px dashed var(--line);
  border-radius: 1rem;
  color: var(--muted);
}

.auth-page,
.financial-page {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 70vh;
}

.auth-card,
.money-card {
  width: min(100%, 520px);
  padding: 1.5rem;
}

.auth-card h2,
.money-card h2 {
  margin-top: 0;
}

.auth-form {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.auth-form label,
.summary-row,
.compact-form label {
  display: flex;
  flex-direction: column;
  gap: 0.45rem;
  color: var(--muted);
}

.full-width {
  width: 100%;
}

.ghost-link,
.text-button {
  border: none;
  background: transparent;
  color: var(--gold-soft);
  font-weight: 700;
}

.profile-grid {
  grid-template-columns: 0.9fr 1.7fr;
}

.profile-card {
  padding: 1.3rem;
}

.avatar {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 4rem;
  height: 4rem;
  border-radius: 1rem;
  background: linear-gradient(135deg, var(--gold-soft), var(--gold));
  color: #0d131d;
  font-weight: 800;
  margin-bottom: 0.8rem;
}

.profile-card h3 {
  margin: 0 0 0.4rem;
}

.profile-card p {
  margin: 0;
  color: var(--muted);
}

.details-card {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 1rem;
}

.details-card div {
  display: flex;
  flex-direction: column;
  gap: 0.35rem;
  color: var(--muted);
}

.details-card strong {
  color: var(--text);
}

.financial-grid {
  grid-template-columns: repeat(2, minmax(0, 1fr));
  margin-top: 1rem;
}

.wide-button {
  width: 100%;
}

.slip-layout {
  display: grid;
  grid-template-columns: 1.7fr 0.9fr;
  gap: 1rem;
}

.slip-card,
.slip-summary-card {
  padding: 1.2rem;
}

.slip-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.8rem;
  padding: 0.9rem 0;
  border-bottom: 1px solid var(--line);
}

.slip-item:last-child {
  border-bottom: none;
}

.slip-item strong,
.slip-item p {
  display: block;
  margin: 0;
}

.slip-item p {
  color: var(--muted);
}

.slip-summary-card {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.summary-row {
  padding: 0.6rem 0;
  border-bottom: 1px solid var(--line);
}

.strong-row {
  border-top: 1px solid var(--line);
  font-size: 1.1rem;
}

.bet-table {
  display: flex;
  flex-direction: column;
  gap: 0.8rem;
}

.bet-row {
  padding: 1rem 1.1rem;
  border: 1px solid var(--line);
  background: rgba(12, 20, 30, 0.96);
  border-radius: 1rem;
}

.bet-row strong,
.bet-row p,
.bet-row span {
  display: block;
  margin: 0;
}

.bet-row p,
.bet-row span {
  color: var(--muted);
}

.settings-list {
  display: flex;
  flex-direction: column;
  gap: 0.8rem;
}

.setting-item {
  padding: 1rem 1.1rem;
}

.top-space {
  margin-top: 1rem;
}

.rtl .brand,
.rtl .selector,
.rtl .nav-link,
.rtl .mini-link,
.rtl .auth-link,
.rtl .topbar,
.rtl .toolbar,
.rtl .header-actions,
.rtl .search-form,
.rtl .header-buttons,
.rtl .hero-panel,
.rtl .score-team,
.rtl .profile-card,
.rtl .bet-row,
.rtl .detail-summary,
.rtl .match-topline,
.rtl .match-meta,
.rtl .match-actions,
.rtl .section-heading,
.rtl .detail-header,
.rtl .summary-row,
.rtl .setting-item,
.rtl .financial-grid,
.rtl .stat-box,
.rtl .hero-copy,
.rtl .hero-panel-card,
.rtl .stats-grid,
.rtl .page-content,
.rtl .match-grid,
.rtl .league-grid,
.rtl .teams-row,
.rtl .top-card-row,
.rtl .mini-stats,
.rtl .score-panel {
  direction: rtl;
}

@media (max-width: 980px) {
  .topbar {
    align-items: flex-start;
  }

  .primary-nav {
    display: none;
    width: 100%;
    order: 4;
    flex-direction: column;
    align-items: stretch;
    padding-top: 0.5rem;
  }

  .primary-nav.open {
    display: flex;
  }

  .menu-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .hero-panel,
  .match-grid,
  .league-grid,
  .wide-grid,
  .stats-grid,
  .slip-layout,
  .profile-grid {
    grid-template-columns: 1fr;
  }

  .toolbar,
  .header-actions {
    width: 100%;
    justify-content: flex-start;
  }

  .search-form {
    width: 100%;
  }
}

@media (max-width: 640px) {
  .page-shell {
    padding: 1rem;
  }

  .topbar {
    padding: 1rem;
  }

  .brand {
    font-size: 1.05rem;
  }

  .selector {
    min-width: 100px;
  }

  .hero-panel {
    padding: 1rem;
  }

  .statistics-grid,
  .detail-summary,
  .odd-grid,
  .detail-odds,
  .financial-grid {
    grid-template-columns: 1fr;
  }

  .bet-row,
  .match-topline,
  .match-actions,
  .section-heading,
  .detail-header,
  .header-buttons {
    flex-direction: column;
    align-items: flex-start;
  }
} 

@media (prefers-reduced-motion: reduce) {
  * {
    scroll-behavior: auto !important;
    transition: none !important;
  }
}
